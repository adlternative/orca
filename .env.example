# Copy to .env.local (gitignored) and fill in what you need.
# config/scripts/run-electron-vite-dev.mjs loads .env.local before starting Electron, and an
# explicit `ORCA_…=… pnpm dev` still wins over the file.

# Qoder Cloud Agents — a Qoder PAT/SAT. Leave empty to connect from Settings > Integrations instead.
ORCA_QODER_ACCESS_TOKEN=

# OpenHands Cloud (optional). ORCA_OPENHANDS_BASE_URL is only needed for a self-hosted deployment.
ORCA_OPENHANDS_API_KEY=
ORCA_OPENHANDS_BASE_URL=

# Claude Managed Agents (optional) — falls back to the token written by `ant auth login`.
ORCA_CLAUDE_MANAGED_API_KEY=
ORCA_CLAUDE_MANAGED_BASE_URL=
